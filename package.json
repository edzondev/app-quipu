{
	"name": "app-quipu",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "biome format --write .",
		"ci:quality": "biome ci .",
		"typecheck": "turbo run typecheck",
		"typecheck:ci": "node scripts/ensure-convex-api.mjs && pnpm exec turbo run typecheck --filter=@quipu/mobile --filter=@quipu/convex-api && pnpm --filter @quipu/web exec tsc -p convex/tsconfig.json --pretty false",
		"test:mobile": "node scripts/ensure-convex-api.mjs && pnpm --filter @quipu/mobile exec jest --watchman=false --coverage=false --watchAll=false"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"turbo": "^2.11.7",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=24"
	}
}
