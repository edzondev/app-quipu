# Copy to .env.local for local Next.js:
#   cp .env.example .env.local
# Convex `npx convex dev` also writes CONVEX_DEPLOYMENT + the NEXT_PUBLIC_CONVEX_* URLs.

NEXT_PUBLIC_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR-DEPLOYMENT.convex.site
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Cloudflare Turnstile — use dummy keys locally so siteverify still runs.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Visible widget that always passes:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional comma-separated hostnames returned by siteverify (omit in local dummy mode):
# TURNSTILE_ALLOWED_HOSTNAMES=localhost,quipu-finance.app

# Android Digital Asset Links — GET /.well-known/assetlinks.json
# Read at request time. No fingerprints (or no package) → 404, not [].
# Colon-separated SHA-256 hex, comma-separated if several certs.
# Local tunnel (dev.quipu-finance.app → localhost:3000): EAS development + preview certs.
# Vercel (quipu-finance.app): Play App Signing cert. Package is not hardcoded in code.
ANDROID_PACKAGE=com.quipu.finance
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99

# Convex deployment env (npx convex env set) — not used by this Next route.
# PASSKEY_RP_ID is the hostname only. Dev: dev.quipu-finance.app. Prod: quipu-finance.app.
# PASSKEY_ANDROID_APK_KEY_HASHES is comma-separated base64url (no android:apk-key-hash: prefix).
# PASSKEY_RP_ID=localhost
# PASSKEY_RP_NAME=quipu
# PASSKEY_ANDROID_APK_KEY_HASHES=

# Optional Polar / analytics (placeholders)
POLAR_SERVER=sandbox
POLAR_PRODUCT_ID_PREMIUM=placeholder
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=
