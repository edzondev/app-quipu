{
	"extends": "@repo/ts-config/nextjs.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"types": ["node"],
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts"
	],
	"exclude": ["node_modules"]
}
