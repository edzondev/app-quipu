{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"codegraph": {
			"type": "local",
			"command": ["codegraph", "serve", "--mcp", "--path", "."],
			"enabled": true
		},
		"codegraph-convex": {
			"type": "local",
			"command": ["codegraph", "serve", "--mcp", "--path", "convex"],
			"enabled": true
		}
	}
}
