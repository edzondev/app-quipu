# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Design canvas (local only; not versioned)
/quipu-2.html

# misc
.DS_Store
*.pem
# Windows reserved device names that sometimes leak into the working tree
nul
aux
con
prn

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# tsc emit accidental (solo _generated es fuente de verdad en convex)
convex/**/*.d.ts
!convex/_generated/**
!convex/**/_generated/**
shared/**/*.d.ts

# AI skills
.agents/*
.claude/*
.cursor/*
.codegraph/*

# Ledger local de SDD (superpowers); docs/ sí se commitea
/.superpowers/sdd/

# Convex prod snapshots (datos reales; no commitear)
/backups/

# Sync local de tipos Convex → app móvil (no commitear)
/mobile-types-out/
/scripts/sync-mobile-types/
/function_spec_*.json
/types.ts

docs/*
!docs/QUIPU-MASTER.md
!docs/manuales-de-sistema.md
!docs/adr/
!docs/security-debt.md
!docs/superpowers/

.turbo
