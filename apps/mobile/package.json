{
  "name": "@quipu/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@better-auth/expo": "1.6.30",
    "@convex-dev/better-auth": "0.12.5",
    "@expo/ui": "^57.0.17",
    "@quipu/convex-api": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "better-auth": "1.6.30",
    "cn": "^0.2.6",
    "convex": "^1.45.0",
    "expo": "~57.0.21",
    "expo-better-auth-passkey": "1.4.3",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "0.10.1",
    "reicon-react-native": "^1.0.102",
    "uniwind": "^1.11.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^4.3.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start -c",
    "prebuild": "expo prebuild --clean",
    "android": "expo start:android",
    "ios": "expo start:ios",
    "maestro:smoke": "maestro test --include-tags=smoke .maestro/",
    "web": "expo start:web",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch --coverage=false --changedSince=origin/master",
    "testDebug": "jest -o --watch --coverage=false",
    "testFinal": "jest",
    "updateSnapshots": "jest -u --coverage=false",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "ci:quality": "biome ci ."
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^react-native-keyboard-controller$": "react-native-keyboard-controller/jest",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "private": true
}
